{
  "name": "pi-durable-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Keep normal Pi; use Pi Durable to recover interrupted work in the same session.",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "start": "pi -e ./src/index.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs",
    "smoke:recovery": "node scripts/live-recovery.mjs",
    "smoke:agents": "PI_DURABLE_LIVE_DELEGATE=1 node scripts/live-recovery.mjs",
    "smoke:workers": "PI_DURABLE_TEMP_PROFILE=1 node scripts/live-recovery.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
